# Copier en `.env` (lu par docker-compose) — ne jamais versionner `.env`.
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/haccp_express
CORS_ALLOWED_ORIGINS=http://localhost:5173
THROTTLE_AUTH_RATE=10/min
